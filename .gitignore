# =============================================================================
# Anvill .gitignore
# =============================================================================

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# MyPy / Testing / Coverage
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/

# Android Portable SDK, System Images & Large Binaries
# (These are auto-downloaded by setup_sdk.py / setup.bat)
android-sdk/
avds/
.android/
jdk/
tools/
screenshots/

# Temporary files & Lock files
*.tmp
*.log
*.lock
*.img.backup
*.db

# IDE & Editor folders
.vscode/
.idea/
*.swp
*.swo
*~
